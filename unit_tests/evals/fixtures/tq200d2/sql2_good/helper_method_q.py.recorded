import sys
import unittest
from pathlib import Path

sys.path.insert(0, "scripts")
from db_check.checker import resolve_test_db_address

import psycopg2


class TestBuyVolumeWindow(unittest.TestCase):
    def setUp(self):
        self.conn = psycopg2.connect(resolve_test_db_address(Path.cwd()))
        self.conn.autocommit = False

    def tearDown(self):
        self.conn.rollback()
        self.conn.close()

    def _q(self, sql, *a):
        with self.conn.cursor() as cur:
            cur.execute(sql, a)
            return cur.fetchone()

    def test_counts(self):
        # covers: TQ-9502
        self.assertEqual(self._q("select count(*), count(buy_volume) from buy_volume_window")[:2], (3, 3))

