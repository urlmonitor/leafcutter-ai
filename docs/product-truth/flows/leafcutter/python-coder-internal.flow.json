              {
                "path": "/red_baseline_verified",
                "types": [
                  "boolean"
                ],
                "required": false
              }
            ]
          }
        ],
        "produces": [
          {
            "contract": "phase-result",
            "fields": [
              {
                "path": "/status",
                "types": [
                  "string"
                ],
                "required": true
              },
              {
                "path": "/message",
                "types": [
                  "string"
                ],
                "required": false
              }
            ]
          }
        ],
        "examples": [
          {
            "contract": "phase-result",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Input illustrative phase-result projection; not an execution receipt",
            "value": {
              "tests_written": [
                "tests/test_service.py"
              ],
              "red_baseline_verified": true
            }
          },
          {
            "contract": "phase-result",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Output illustrative phase-result projection; not an execution receipt",
            "value": {
              "status": "ok",
              "message": "The assigned phase completed; the ticket retains its evidence."
            }
          }
        ]
      },
      "consumes": [
        "phase-result/tests_written: array (optional)",
        "phase-result/red_baseline_verified: boolean (optional)"
      ],
      "produces": [
        "phase-result/status: string (required)",
        "phase-result/message: string (optional)"
      ]
    },
    {
      "id": "signoff",
      "label": "Record sign-off",
      "description": "The coding agent records its sign-off, updating the ticket's status and its sign-off checklist together.",
      "order": 6,
      "agent": "python-coder",
      "actor_kind": "llm",
      "implements": [
        "BO-2000a"
      ],
      "impl_status": "not_started",
      "impl_asof": "2026-07-20",
      "io_contracts": {
        "consumes": [
          {
            "contract": "planner",
            "fields": [
              {
                "path": "/ticket_path",
                "types": [
                  "string"
                ],
                "required": true
              }
            ]
          }
        ],
        "produces": [
          {
            "contract": "readback",
            "fields": [
              {
                "path": "/readable",
                "types": [
                  "boolean"
                ],
                "required": true
              },
              {
                "path": "/ticket_path",
                "types": [
                  "string"
                ],
                "required": false
              },
              {
                "path": "/signoffs/*/agent",
                "types": [
                  "string"
                ],
                "required": false
              },
              {
                "path": "/signoffs/*/status",
                "types": [
                  "string"
                ],
                "required": false
              },
              {
                "path": "/signed_off_agents",
                "types": [
                  "array"
                ],
                "required": false
              }
            ]
          }
        ],
        "examples": [
          {
            "contract": "planner",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Input illustrative planner projection; not an execution receipt",
