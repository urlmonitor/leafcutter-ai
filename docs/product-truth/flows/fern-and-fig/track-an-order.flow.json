  "acceptance_scenarios": [
    {
      "for": "orders",
      "given": "a customer with past orders",
      "when": "they open 'My orders'",
      "then": "each order shows its number, item, total and status"
    },
    {
      "for": "noOrders",
      "given": "a customer who has never placed an order",
      "when": "they open 'My orders'",
      "then": "an empty state is shown inviting them to browse the catalogue, with no order rows"
    },
    {
      "for": "orderDetail",
      "given": "the orders list",
      "when": "the customer opens one order",
      "then": "the order detail shows item, quantity, total, payment status and date"
    },
    {
      "for": "track",
      "given": "a paid order that has been dispatched",
      "when": "the customer opens 'Track shipment'",
      "then": "they see the carrier, tracking number and the current delivery stage for that order"
    },
    {
      "for": "trackingUnavailable",
      "given": "a paid order that has not yet been dispatched (no tracking number)",
      "when": "the customer opens 'Track shipment'",
      "then": "they see a 'not shipped yet' state explaining tracking will appear once the parcel is on its way, and no fake delivery stage is shown"
    }
  ],
