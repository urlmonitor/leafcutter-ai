# Normalise all text files to LF on checkout.
# Prevents phantom git modifications on WSL2/NTFS mounts.
* text=auto eol=lf

# Binary files — never normalise
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.tar.gz binary
*.pdf binary

