{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/readme_read_guard.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python .claude/hooks/documentation_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/readme_marker_recorder.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/ticket_frontmatter_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
