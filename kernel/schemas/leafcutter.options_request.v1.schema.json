{
  "$id": "leafcutter.options_request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "leafcutter.options_request.v1.",
  "properties": {
    "constraint_ids": {
      "items": {
        "type": "string"
      },
      "title": "Constraint Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "existing_option_ids": {
      "items": {
        "type": "string"
      },
      "title": "Existing Option Ids",
      "type": "array"
    },
    "max_options": {
      "default": 5,
      "minimum": 0,
      "title": "Max Options",
      "type": "integer"
    },
    "problem": {
      "minLength": 1,
      "title": "Problem",
      "type": "string"
    },
    "propose_criteria": {
      "default": false,
      "title": "Propose Criteria",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "problem"
  ],
  "title": "OptionsRequestPayload",
  "type": "object"
}
