    "exception_handling": {
        "_comment": "check_exception_handling.py — AST-based I/O boundary and exception-clause enforcement. Ruff rules E722, BLE001, and TRY are also enforced via pyproject.toml [tool.ruff.lint] select. This section configures the custom AST check.",
        "ruff_rules": ["E722", "BLE001", "TRY"],
        "io_boundary_calls": [
            "requests.get",
            "requests.post",
            "requests.put",
            "requests.patch",
            "requests.delete",
            "requests.head",
            "requests.options",
            "requests.request",
            "open",
            "cursor.execute",
            "cursor.executemany",
            "cursor.callproc",
            "subprocess.run",
            "subprocess.Popen",
            "subprocess.call",
            "subprocess.check_call",
            "subprocess.check_output",
            "subprocess.getoutput"
        ],
        "blind_exception_names": ["Exception", "BaseException"]
    },
    "mermaid_complexity": {
        "_comment": "check_mermaid_complexity.py — Structural complexity limits for mermaid diagrams in .md files. Warn-only by default; set strict: true to block commits.",
        "strict": false,
        "max_nodes": 15,
        "max_edges": 20,
        "max_participants": 8,
        "max_interactions": 25,
        "max_tables": 12,
        "max_states": 10,
        "max_classes": 10,
        "max_boundaries": 4
    },
    "duplicate_code": {
        "_comment": "check_duplicate_code.py — Copy-paste clone detection using jscpd. Disabled by default. Fails open when jscpd is not installed or when jscpd v4.x is detected. Set strict: true to block commits on threshold violations. threshold_percent sets the percentage of duplicate code that triggers a warning/error. checked_extensions restricts scanning to the listed file types.",
        "enabled": false,
        "strict": false,
        "min_lines": 5,
        "min_tokens": 50,
        "threshold_percent": 5,
        "checked_extensions": [".py", ".ts", ".js", ".tsx", ".jsx", ".sql"],
        "excluded_dirs": ["node_modules", ".venv", "__pycache__"]
    },
    "diff_coverage": {
        "_comment": "check_diff_coverage.py — Diff-based coverage gating using diff-cover. Disabled by default. Fails open when diff-cover is not installed or coverage.xml is absent. Set strict: true to block commits when coverage falls below min_coverage_percent. max_age_seconds guards against stale coverage artifacts.",
        "enabled": false,
        "strict": false,
        "min_coverage_percent": 80,
        "coverage_xml_path": "coverage.xml",
        "compare_branch": "origin/main",
        "max_age_seconds": 3600
    },
    "hook_parity": {
        "_comment": "check_hook_parity.py — Parity enforcement across runtime dir, canonical template dir, legacy template dir, and deployed output dir. All paths are relative to the project root. H-2: This section was absent from this file (scripts/commit_guardian/commit_guardian.json) in the original implementation; build.py copies this file from templates/scripts/commit_guardian/commit_guardian.json on each rebuild, so the section will be preserved after any rebuild.",
        "runtime_dir": "scripts/commit_guardian",
        "canonical_template_dir": "templates/scripts/commit_guardian",
        "legacy_template_dir": "templates/commit-guardian",
        "deployed_output_dir": ".leafcutter/scripts/commit_guardian",
        "manifests": {
            "canonical": "templates/scripts/commit_guardian/commit_guardian.json",
            "legacy": "templates/commit-guardian/commit_guardian.json"
        },
        "excluded_scripts": [],
        "hook_script_patterns": ["check_*.py", "run_hook.py", "regenerate_*.py"]
    }
