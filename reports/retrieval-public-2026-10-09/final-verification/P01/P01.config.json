      "**/*.pem",
      "**/*.key",
      ".security-allowlist",
      "**/.git/**"
    ],
    "coverage_relevance_threshold": 0.7,
    "sections_per_file": 3,
    "max_section_lines": 120,
    "source_candidate_floor": 20,
    "source_candidate_ratio": 1.5,
    "max_explicit_locators": 12,
    "max_query_terms": 48,
    "rerank_max_per_need": 20,
    "rerank_max_batches": 3,
    "satisfied_min_items": 2,
    "satisfied_strong_threshold": 0.85,
    "self_reference_ratio": 0.6,
    "self_reference_penalty": 0.5,
    "path_match_weight": 3,
    "bm25_k1": 2.0,
    "bm25_b": 0.5,
    "pool_sections_per_file": 2,
    "pool_fair_share": 2,
    "pool_fair_min_ratio": 0.3,
    "rerank_min_items": 3,
    "rerank_stop_ratio": 0.5,
    "review_quote_ratio": 0.5,
    "review_path_markers": [
      "trace-review"
    ],
    "registry_pin_min_terms": 2
  },
  "sources": [
    {
      "id": "knowledge.graph",
      "kind": "graph_query",
      "categories": [
        "task_context"
      ]
    }
  ],
  "jev": {
    "model": "jev-latest",
    "transport": "classifier",
    "timeout_seconds": 30,
    "max_questions_per_call": 20,
    "max_state_chars": 60000,
    "retry_backoff_seconds": 1.0,
    "price_per_input_token_usd": 4.2e-08
  },
  "host": {
    "enabled": true,
    "fallback_on_no_match": true,
    "max_repair_attempts": 1,
    "formulate_questions": false,
    "max_input_chars": 60000
  },
  "data_policy": {
    "send_repo_excerpts_to_jev": true,
    "telemetry_excerpts": "truncated",
    "telemetry_max_field_chars": 4000
  },
  "langfuse": {
    "enabled": false,
    "environment": "development",
    "trace_name": "leafcutter-run",
    "flush_on_exit": true
  },
  "memory": {
    "backend": "null",
    "repository_id": "leafcutter-ai",
    "decisions_dir": "docs/decisions",
    "max_precedents": 3,
    "min_candidate_score": 0.3,
    "applies_threshold": 0.5,
    "reuse_threshold": 0.8,
    "criterion_evidence_max": 5,
    "criterion_evidence_min_overlap": 2
  }
}
