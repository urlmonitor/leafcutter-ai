{
  "id": "leafcutter/deliver-a-feature",
  "component": "build-pipeline",
  "product": "Leafcutter",
  "name": "Deliver a feature end-to-end",
  "level": "journey",
  "summary": "The top-altitude journey of shipping a feature with Leafcutter: you say what you want and the acceptance criteria get authored (plan), the wired ticket is driven through its phase agents until it is green and committed (build), and the PR is merged and the epic/ticket closed (finalize). Each of the three stages drills down into its own pipeline flow — plan into define-a-feature, build into how-a-ticket-is-built, finalize into the finalize-feature pipeline — so this journey is the C4 L0 map over the whole delivery system.",
  "kind": "user",
  "source": "real",
  "realization": "built",
  "status": "active",
  "readiness": "approved",
  "superseded_by": null,
  "version": 2,
  "tags": [
    "build-pipeline",
    "journey",
    "hierarchy",
    "c4-l0"
  ],
  "entities": [],
  "steps": [
    {
      "id": "plan",
      "label": "Plan",
      "description": "You say what you want and AI agents author the acceptance criteria for it.",
      "actor_kind": "llm",
      "order": 1,
      "expands_to": [
        "leafcutter/define-a-feature"
      ],
      "implements": [
        "ACD-300"
      ],
      "impl_status": "in_progress",
      "impl_asof": "2026-07-20",
      "io_contracts": {
        "consumes": [],
        "produces": [
          {
            "contract": "ac",
            "fields": [
              {
                "path": "/id",
                "types": [
                  "string"
                ],
                "required": true
              },
              {
                "path": "/criteria",
                "types": [
                  "string"
                ],
                "required": true
              },
              {
                "path": "/readiness",
                "types": [
                  "string"
                ],
                "required": false
              },
              {
                "path": "/assigned_agent",
                "types": [
                  "null",
                  "string"
                ],
                "required": false
              }
            ]
          }
        ],
        "examples": [
          {
            "contract": "ac",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Output illustrative ac projection; not an execution receipt",
            "value": {
              "id": "ACD-300",
              "criteria": "Given an approved requirement, When delivery finishes, Then its evidence is recorded.",
              "readiness": "draft",
              "assigned_agent": "python-coder"
            }
          }
        ]
      },
      "consumes": [],
      "produces": [
        "ac/id: string (required)",
        "ac/criteria: string (required)",
        "ac/readiness: string (optional)",
        "ac/assigned_agent: null|string (optional)"
      ]
    },
    {
      "id": "build",
      "label": "Build",
      "description": "AI phase agents drive the wired ticket through its build phases until it is green and committed.",
      "actor_kind": "llm",
      "order": 2,
      "expands_to": [
        "leafcutter/how-acs-are-built"
      ],
      "implements": [
        "BP-300"
      ],
      "impl_status": "in_progress",
      "impl_asof": "2026-07-20",
      "io_contracts": {
        "consumes": [
          {
            "contract": "planner",
            "fields": [
              {
                "path": "/ticket_path",
                "types": [
                  "string"
                ],
                "required": true
              },
              {
                "path": "/source_ac",
                "types": [
                  "array"
                ],
                "required": false
              },
              {
                "path": "/ordered_phases",
                "types": [
                  "array"
                ],
                "required": true
              }
            ]
          }
        ],
        "produces": [
          {
            "contract": "phase-result",
            "fields": [
              {
                "path": "/status",
                "types": [
                  "string"
                ],
                "required": true
              },
              {
                "path": "/message",
                "types": [
                  "string"
                ],
                "required": false
              }
            ]
          }
        ],
        "examples": [
          {
            "contract": "planner",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Input illustrative planner projection; not an execution receipt",
            "value": {
              "ticket_path": "tickets/01_todo/feature.md",
              "source_ac": [
                "ACD-300"
              ],
              "ordered_phases": [
                {
                  "agent": "test-writer",
                  "status": "needed"
                },
                {
                  "agent": "python-coder",
                  "status": "needed"
                }
              ]
            }
          },
          {
            "contract": "phase-result",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Output illustrative phase-result projection; not an execution receipt",
            "value": {
              "status": "ok",
              "message": "The assigned phase completed; the ticket retains its evidence."
            }
          }
        ]
      },
      "consumes": [
        "planner/ticket_path: string (required)",
        "planner/source_ac: array (optional)",
        "planner/ordered_phases: array (required)"
      ],
      "produces": [
        "phase-result/status: string (required)",
        "phase-result/message: string (optional)"
      ]
    },
    {
      "id": "finalize",
      "label": "Finalize",
      "description": "The finalize pipeline merges the pull request and closes the epic or ticket.",
      "actor_kind": "deterministic",
      "order": 3,
      "expands_to": [
        "leafcutter/finalize-feature"
      ],
      "implements": [
        "FIN-100"
      ],
      "impl_status": "in_progress",
      "impl_asof": "2026-07-20",
      "io_contracts": {
        "consumes": [
          {
            "contract": "readback",
            "fields": [
              {
                "path": "/ticket_path",
                "types": [
                  "string"
                ],
                "required": false
              },
              {
                "path": "/lifecycle_status",
                "types": [
                  "string"
                ],
                "required": false
              },
              {
                "path": "/needed_phases",
                "types": [
                  "array"
                ],
                "required": false
              },
              {
                "path": "/failed_phases",
                "types": [
                  "array"
                ],
                "required": false
              },
              {
                "path": "/signoffs",
                "types": [
                  "array"
                ],
                "required": false
              }
            ]
          }
        ],
        "produces": [
          {
            "contract": "ac",
            "fields": [
              {
                "path": "/id",
                "types": [
                  "string"
                ],
                "required": true
              },
              {
                "path": "/work_status",
                "types": [
                  "null",
                  "string"
                ],
                "required": false
              },
              {
                "path": "/implemented_by",
                "types": [
                  "array"
                ],
                "required": false,
                "default": []
              },
              {
                "path": "/covered_by",
                "types": [
                  "array"
                ],
                "required": false,
                "default": []
              }
            ]
          }
        ],
        "examples": [
          {
            "contract": "readback",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Input illustrative readback projection; not an execution receipt",
            "value": {
              "ticket_path": "tickets/01_todo/feature.md",
              "lifecycle_status": "in_progress",
              "needed_phases": [
                "python-coder"
              ],
              "failed_phases": [],
              "signoffs": [
                {
                  "agent": "test-writer",
                  "status": "passed"
                }
              ]
            }
          },
          {
            "contract": "ac",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Output illustrative ac projection; not an execution receipt",
            "value": {
              "id": "ACD-300",
              "work_status": "done",
              "implemented_by": [
                "app/service.py"
              ],
              "covered_by": [
                "tests/test_service.py::test_contract"
              ]
            }
          }
        ]
      },
      "consumes": [
        "readback/ticket_path: string (optional)",
        "readback/lifecycle_status: string (optional)",
        "readback/needed_phases: array (optional)",
        "readback/failed_phases: array (optional)",
        "readback/signoffs: array (optional)"
      ],
      "produces": [
        "ac/id: string (required)",
        "ac/work_status: null|string (optional)",
        "ac/implemented_by: array (optional; default [])",
        "ac/covered_by: array (optional; default [])"
      ]
    }
  ],
  "branches": [],
  "acceptance_scenarios": [
    {
      "for": "plan",
      "given": "a person with a feature idea",
      "when": "they describe it in plain language",
      "then": "the acceptance criteria are authored via the define-a-feature pipeline this step drills into"
    },
    {
      "for": "build",
      "given": "a wired ticket produced from approved ACs",
      "when": "the build stage runs",
      "then": "the ticket is driven through the phase chain this step drills into until it is green and committed"
    },
    {
      "for": "finalize",
      "given": "a committed feature branch with an open PR",
      "when": "the finalize stage runs",
      "then": "the PR is merged and the epic/ticket is closed via the finalize-feature pipeline this step drills into"
    }
  ],
