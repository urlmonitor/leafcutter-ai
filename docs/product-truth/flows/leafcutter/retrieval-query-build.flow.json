        "choice_answer/choice: string (required)",
        "choice_answer/probabilities: object (required)",
        "choice_answer/confidence: null|number (optional; default null)"
      ],
      "impl_asof": "2026-10-02",
      "impl_status": "not_started",
      "consumes": [
        "fit/status: string (required)",
        "fit/query_build_eligible: boolean (required)",
        "fit/missing_fields: object (required)",
        "fit/limitations: array (required)",
        "jev_batch/purpose: string (required)",
        "jev_batch/questions: array (required)"
      ],
