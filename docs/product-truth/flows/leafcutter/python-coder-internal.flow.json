{
  "id": "leafcutter/python-coder-internal",
  "component": "build-pipeline",
  "product": "Leafcutter",
  "name": "Inside python-coder (the coder's internal workflow)",
  "level": "agent",
  "summary": "The internal workflow python-coder runs when the build pipeline's code step hands it a red baseline: it loads the project conventions / PROJECT_CONTEXT, edits only the ticket's files_touched to satisfy the red baseline, runs doc-enforcer on the changed Python, runs complexity-reduction, runs the suite until it is green, and finally records its sign-off via the signoff skill. This is the agent-altitude drill-down beneath the code step of how-a-ticket-is-built.",
  "kind": "data",
  "source": "real",
  "realization": "built",
  "status": "active",
  "readiness": "approved",
  "superseded_by": null,
  "version": 2,
  "tags": [
    "build-pipeline",
    "python-coder",
    "agent-internal",
    "hierarchy"
  ],
  "entities": [],
  "steps": [
    {
      "id": "conventions",
      "label": "Load conventions",
      "description": "The coding agent loads the project's conventions so its code matches the repository's error-handling, style and structure rules.",
      "order": 1,
      "agent": "python-coder",
      "actor_kind": "llm",
      "implements": [
        "BO-2000b"
      ],
      "impl_status": "not_started",
      "impl_asof": "2026-07-20",
      "io_contracts": {
        "not_applicable": "Input is the Python coder prompt plus Markdown CLAUDE.md/PROJECT_CONTEXT and repository conventions; output is the agent working context. No JSON artifact is authored at this reading step."
      },
      "consumes": [],
      "produces": []
    },
    {
      "id": "implement",
      "label": "Implement against red",
      "description": "The coding agent edits only the files the ticket names, to make the failing tests handed over by the test-writing agent pass.",
      "order": 2,
      "agent": "python-coder",
      "actor_kind": "llm",
      "implements": [
        "BP-1100a"
      ],
      "impl_status": "not_started",
      "impl_asof": "2026-07-20",
      "io_contracts": {
        "consumes": [
          {
            "contract": "planner",
            "fields": [
              {
                "path": "/ticket_path",
                "types": [
                  "string"
                ],
                "required": true
              },
              {
                "path": "/files_touched",
                "types": [
                  "array"
                ],
                "required": false
              },
              {
                "path": "/existing_test_files",
                "types": [
                  "array"
                ],
                "required": false
              },
              {
                "path": "/source_ac",
                "types": [
                  "array"
                ],
                "required": false
              }
            ]
          },
          {
            "contract": "phase-result",
            "fields": [
              {
                "path": "/tests_written",
                "types": [
                  "array"
                ],
                "required": false
              },
              {
                "path": "/red_baseline_verified",
                "types": [
                  "boolean"
                ],
                "required": false
              }
            ]
          }
        ],
        "produces": [],
        "examples": [
          {
            "contract": "planner",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Input illustrative planner projection; not an execution receipt",
            "value": {
              "ticket_path": "tickets/01_todo/feature.md",
              "files_touched": [
                "app/service.py"
              ],
              "existing_test_files": [
                "tests/test_service.py"
              ],
              "source_ac": [
                "ACD-300"
              ]
            }
          },
          {
            "contract": "phase-result",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Input illustrative phase-result projection; not an execution receipt",
            "value": {
              "tests_written": [
                "tests/test_service.py"
              ],
              "red_baseline_verified": true
            }
          }
        ]
      },
      "consumes": [
        "planner/ticket_path: string (required)",
        "planner/files_touched: array (optional)",
        "planner/existing_test_files: array (optional)",
        "planner/source_ac: array (optional)",
        "phase-result/tests_written: array (optional)",
        "phase-result/red_baseline_verified: boolean (optional)"
      ],
      "produces": []
    },
    {
      "id": "docenforce",
      "label": "Doc-enforcer",
      "description": "The documentation enforcer checks the changed Python files against the project's docstring and documentation conventions.",
      "order": 3,
      "agent": "doc-enforcer",
      "actor_kind": "llm",
      "implements": [
        "BO-2000b"
      ],
      "impl_status": "not_started",
      "impl_asof": "2026-07-20",
      "io_contracts": {
        "not_applicable": "doc-enforcer consumes changed Python files and documentation conventions and returns diagnostics/code edits under its skill contract. This flow defines no JSON diagnostic envelope; the file diff and command output are the artifacts."
      },
      "consumes": [],
      "produces": []
    },
    {
      "id": "complexity",
      "label": "Complexity reduction",
      "description": "The coding agent simplifies the new code to keep it within the repository's complexity budget.",
      "order": 4,
      "agent": "python-coder",
      "actor_kind": "llm",
      "implements": [
        "BO-2000b"
      ],
      "impl_status": "not_started",
      "impl_asof": "2026-07-20",
      "io_contracts": {
        "not_applicable": "The complexity-reduction skill inspects and refactors source files under the existing complexity budget. Its output is a source diff plus measurements/report text, not an invented JSON score DTO."
      },
      "consumes": [],
      "produces": []
    },
    {
      "id": "tests",
      "label": "Run until green",
      "description": "The test agent runs the suite until every test in the failing baseline passes.",
      "order": 5,
      "agent": "test-runner",
      "actor_kind": "llm",
      "implements": [
        "BO-530-2"
