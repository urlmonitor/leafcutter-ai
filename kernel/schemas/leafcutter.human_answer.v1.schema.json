{
  "$defs": {
    "AddedOption": {
      "additionalProperties": false,
      "description": "One option the human adds inside a structured approval answer.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "AddedOption",
      "type": "object"
    },
    "CriterionEdit": {
      "additionalProperties": false,
      "description": "One criterion the human supplies or edits inside a structured approval answer.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "required"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "CriterionEdit",
      "type": "object"
    },
    "Priority": {
      "description": "Required (blocking) versus supporting work.",
      "enum": [
        "required",
        "supporting"
      ],
      "title": "Priority",
      "type": "string"
    }
  },
  "$id": "leafcutter.human_answer.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "leafcutter.human_answer.v1: one of choice_id, free_text or a structured answer.\n\nThe pair {choice_id, free_text} is also one mode: a choice with a condition. The choice is\nauthoritative and the text is recorded verbatim as the condition.\n\nThe structured answer answers an approve-or-edit question about proposed criteria and\noptions: `approved_*_ids` approve a subset (the listed ids are approved, every other pending\nproposal of that kind is declined) and `edited_criteria` replaces the pending criteria by the\nhuman's own (an entry with the id of a proposal edits it, an entry without an id is new).",
  "properties": {
    "added_options": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/AddedOption"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Added Options"
    },
    "approved_criterion_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved Criterion Ids"
    },
    "approved_option_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved Option Ids"
    },
    "choice_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Choice Id"
    },
    "edited_criteria": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CriterionEdit"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edited Criteria"
    },
    "free_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Free Text"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "HumanAnswerPayload",
  "type": "object"
}
