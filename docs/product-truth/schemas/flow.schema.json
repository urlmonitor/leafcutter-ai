{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flow artifact",
  "description": "A reviewable user journey. Machine-readable for agents AND human-readable via summary/human fields. business-analyst derives L2/L3 Gherkin ACs from steps + branches; each step links back to those ACs via `implements`, and impl_status is derived from the ACs' work_status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "component", "name", "summary", "kind", "source", "status", "readiness", "version", "entities", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$", "description": "<product>/<name>, path-stable." },
    "component": { "type": "string" },
    "product": { "type": "string" },
    "name": { "type": "string" },
    "kind": { "type": "string", "enum": ["user", "data", "architecture"], "description": "What the flow describes: a user journey, a data pipeline, or an architecture process." },
    "source": { "type": "string", "enum": ["mock", "real"], "description": "Whether the flow is a mock/demo journey or a real system process." },
    "summary": { "type": "string", "description": "HUMAN: one-paragraph plain-language description of the whole journey." },
    "status": { "type": "string", "enum": ["active", "deprecated"], "description": "Lifecycle: is this journey live or retired." },
    "readiness": { "type": "string", "enum": ["draft", "reviewed", "approved"], "description": "Review state: has a persona approved it yet." },
    "superseded_by": { "type": ["string", "null"], "description": "id of the artifact replacing this one when status=deprecated." },
    "version": { "type": "integer", "minimum": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "entities": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" } },
    "mock_data_ref": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$", "description": "id of the Mock Data artifact populating this flow." },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "human", "order"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string", "description": "Short title (tab-label)." },
          "human": { "type": "string", "description": "HUMAN: one-line 'what the user is doing/seeing' on this step." },
          "order": { "type": "integer" },
          "screen": { "type": "string", "description": "mockup id this step renders, if any." },
          "reads": { "type": "array", "items": { "type": "string" } },
          "writes": { "type": "array", "items": { "type": "string" } },
          "implements": { "type": "array", "items": { "type": "string" }, "description": "AC ids (docs/acceptance-criteria/) derived from this step's acceptance_scenarios. AUTHORED link — the source of truth for graph↔AC linkage." },
          "impl_status": { "type": "string", "enum": ["not_started", "in_progress", "done"], "description": "DERIVED from work_status of every AC in `implements`. Regenerated by the impl-status generator; never hand-edited." },
          "impl_asof": { "type": "string", "description": "Date impl_status was last recomputed." }
        }
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "condition", "label"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string", "description": "step id this branches from." },
          "condition": { "type": "string" },
          "label": { "type": "string" },
          "human": { "type": "string" },
          "screen": { "type": "string" },
          "reads": { "type": "array", "items": { "type": "string" } },
          "writes": { "type": "array", "items": { "type": "string" } },
          "implements": { "type": "array", "items": { "type": "string" } },
          "impl_status": { "type": "string", "enum": ["not_started", "in_progress", "done"] },
          "impl_asof": { "type": "string" }
        }
      }
    },
    "impl_summary": {
      "type": "object",
      "additionalProperties": false,
      "description": "DERIVED rollup across steps + branches, for the visualizer to badge the whole journey.",
      "properties": {
        "done": { "type": "integer" },
        "in_progress": { "type": "integer" },
        "not_started": { "type": "integer" },
        "total": { "type": "integer" },
        "asof": { "type": "string" }
      }
    },
    "acceptance_scenarios": {
      "type": "array",
      "description": "Given/When/Then seeds the business-analyst turns into L2/L3 ACs. Double as human documentation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["for", "given", "when", "then"],
        "properties": {
          "for": { "type": "string", "description": "id of the step OR branch this scenario covers (steps + branches share one id namespace)." },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "enum": ["authored", "reviewed", "approved", "extended", "deprecated", "superseded"] },
          "by": { "type": "string" },
          "date": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
