  "acceptance_scenarios": [
    {
      "for": "map",
      "given": "an AC store with work_status on each criterion",
      "when": "the generator runs",
      "then": "it builds one ac_id -> work_status map in a single pass"
    },
    {
      "for": "derive",
      "given": "flows whose steps carry implements links",
      "when": "the generator derives status",
      "then": "each step's impl_status and the flow's impl_summary are recomputed from the ACs' work_status"
    },
    {
      "for": "invert",
      "given": "the authored flow->AC edges",
      "when": "the generator inverts them",
      "then": "the by_ac index and the derived reverse indexes in index.json are rebuilt"
    },
    {
      "for": "backref",
      "given": "the by_ac inversion",
      "when": "the generator writes back-references",
      "then": "each referenced AC's product_truth block equals its by_ac list (wholesale, many-to-many)"
    },
    {
      "for": "validate",
      "given": "the generated derived data",
      "when": "the validator runs",
      "then": "it errors on any drift between a derived field and its source"
    },
    {
      "for": "derive",
      "given": "the structured JSON contract metadata and the applicable source contracts",
      "when": "Derive each step's impl_status and roll up impl_summary",
      "then": "The generator also derives compatibility consumes/produces labels and the technical human suffix from io_contracts, preserving the authored narrative and avoiding a second editable source of field names or examples."
    },
    {
      "for": "validate",
      "given": "the structured JSON contract metadata and the applicable source contracts",
      "when": "Fail on derived-vs-source drift",
      "then": "The same validator verifies declared field paths, types, requiredness and defaults; complete and projected examples; observed receipt provenance; required metadata for every flow node; and drift in generated contract presentation. Declared proposed binding gaps remain visible and are counted separately from implemented interfaces."
    }
  ],
