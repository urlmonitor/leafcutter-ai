# Normalise all text files to LF on checkout.
# Prevents phantom git modifications on WSL2/NTFS mounts.
* text=auto eol=lf

# Binary files — never normalise
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.tar.gz binary
*.pdf binary

# Preserve immutable evaluation receipt bytes and the exact recorded replay source.
reports/retrieval-scenarios-2026-10-02/**/*.json -text
reports/retrieval-scenarios-2026-10-02-post-sync-84006ac3/**/*.json -text
reports/retrieval-scenarios-2026-10-02-post-sync-84006ac3/replay-recorded.py.txt -text

