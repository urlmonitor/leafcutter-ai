# Build outputs (generated by build.py into target project)
.claude/.cache/
.claude/agents/
.claude/skills/
.claude/commands/
.claude/hooks/
.claude/worktrees/
.claude/projects/
.claude/memory/
.pre-commit-config.yaml

# User-local settings (not shared across machines)
.claude/settings.json
.claude/settings.local.json

# Legacy path convention
.agents/rules/

# Python
__pycache__/
*.pyc

# Build manifest (generated per-build, machine-specific hashes)
.build_manifest.json
