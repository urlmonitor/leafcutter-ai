import sys
from pathlib import Path

for _p in (Path(__file__).resolve().parents[0], Path(__file__).resolve().parents[1]):
    sys.path.insert(0, str(_p))
from cvd_gate import gate_open

ROWS = [
    {"symbol": "AAA", "cvd": 12.0, "cvd_delta_30": -4.0},
    {"symbol": "BBB", "cvd": -3.0, "cvd_delta_30": 7.5},
]


def test_gate_reads_the_moved_input():
    # covers: TQ-9301
    assert gate_open(ROWS[0]) is False
    assert gate_open(ROWS[1]) is True
