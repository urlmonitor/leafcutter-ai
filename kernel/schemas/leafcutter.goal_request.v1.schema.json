{
  "$id": "leafcutter.goal_request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "leafcutter.goal_request.v1: a free-form goal for the root capability request.",
  "properties": {
    "clarifications": {
      "items": {
        "type": "string"
      },
      "title": "Clarifications",
      "type": "array"
    },
    "context_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Summary"
    },
    "goal": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "goal"
  ],
  "title": "GoalRequestPayload",
  "type": "object"
}
