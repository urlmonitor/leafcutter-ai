{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-validate-result.schema.json",
  "title": "decision-validate-result",
  "description": "Source-reviewed documentation of kernel/memory/cli.py normal or refused command JSON; environment-error documents are a separate shape. No automatic source-code parity or runtime schema enforcement is claimed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "problems",
    "records"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "message"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "records": {
      "type": "integer",
      "minimum": 0
    }
  }
}
