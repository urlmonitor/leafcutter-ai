{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source-reviewed ac-triage prompt output",
  "description": "Documentation transcription of templates/agents/ac-triage.md Step 3 Return JSON; no automatic prompt/schema parity or runtime registration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route",
    "existing_acs",
    "parent_l1_id",
    "rationale",
    "anomalies"
  ],
  "properties": {
    "route": {
      "type": "string",
      "enum": [
        "strategic",
        "behavioral",
        "technical",
        "covered"
      ]
    },
    "existing_acs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_l1_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
