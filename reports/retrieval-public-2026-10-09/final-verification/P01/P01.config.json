  "limits": {
    "max_work_items": 32,
    "max_depth": 4,
    "max_concurrent_native": 4,
    "max_concurrent_host": 1,
    "max_retries": 0,
    "no_progress_limit": 2,
    "max_jev_calls": 12,
    "max_host_operations": 3,
    "max_active_seconds": 150,
    "max_cost_usd": null,
