                "path": "/purpose",
                "types": [
                  "string"
                ],
                "required": true
              },
              {
                "path": "/questions",
                "types": [
                  "array"
                ],
                "required": true
              }
            ]
          }
        ],
        "produces": [
          {
            "contract": "choice_answer",
            "fields": [
              {
                "path": "/choice",
                "types": [
                  "string"
                ],
                "required": true
              },
              {
                "path": "/probabilities",
                "types": [
                  "object"
                ],
                "required": true
