{
  "$defs": {
    "PartProposal": {
      "additionalProperties": false,
      "description": "One proposed part: its id, text, the verbatim span it quotes, dependencies and capability.",
      "properties": {
        "child_capability": {
          "enum": [
            "decision",
            "research"
          ],
          "title": "Child Capability",
          "type": "string"
        },
        "covers": {
          "minLength": 1,
          "title": "Covers",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "covers",
        "child_capability"
      ],
      "title": "PartProposal",
      "type": "object"
    }
  },
  "$id": "leafcutter.goal_decomposition.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "leafcutter.goal_decomposition.v1: the parts the host proposes (a proposal, never a fact).\n\nZero parts up to `MAX_PROPOSED_PARTS` are legal: more than `split.max_parts` is cut by the\nconversion, and fewer than two ends the split there (not at the schema).",
  "properties": {
    "one_question_rewording": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "One Question Rewording"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/PartProposal"
      },
      "maxItems": 12,
      "title": "Parts",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "parts"
  ],
  "title": "GoalDecompositionPayload",
  "type": "object"
}
