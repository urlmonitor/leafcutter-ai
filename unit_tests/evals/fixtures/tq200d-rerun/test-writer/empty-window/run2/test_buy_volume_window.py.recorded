import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from buy_volume_window import buy_volumes


def test_every_row_in_the_window_has_non_negative_buy_volume():
    # covers: TQ-9302
    window = [{"buy_volume": 4.0}, {"buy_volume": 0.0}, {"buy_volume": 2.5}]
    volumes = buy_volumes(window)
    assert len(volumes) == 3
    assert sum(v is not None for v in volumes) == 3
    assert all(v >= 0 for v in volumes)
