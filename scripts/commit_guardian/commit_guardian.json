                "name": "Check Diff Coverage (diff-cover coverage gating)",
                "entry": "python {{config.output_root}}/scripts/commit_guardian/run_hook.py {{config.output_root}}/scripts/commit_guardian/check_diff_coverage.py",
                "language": "system",
                "files": "\\.(py|sql)$",
                "stages": [
                    "pre-commit"
