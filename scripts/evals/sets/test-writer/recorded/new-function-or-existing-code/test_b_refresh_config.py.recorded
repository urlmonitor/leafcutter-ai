import sys
from pathlib import Path

for _p in (Path(__file__).resolve().parents[0], Path(__file__).resolve().parents[1]):
    sys.path.insert(0, str(_p))
from refresh_config import refresh_config


def test_refresh_config_keeps_a_zero_override():
    # covers: TQ-9304
    assert refresh_config({"retries": 0})["retries"] == 0
