{
  "$defs": {
    "ApprovalStatus": {
      "description": "Approval state of a decision, criterion or constraint.",
      "enum": [
        "not_required",
        "proposed",
        "approved",
        "rejected"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "Criterion": {
      "additionalProperties": false,
      "description": "A question an option must satisfy; required criteria gate resolution.",
      "properties": {
        "approval_status": {
          "$ref": "#/$defs/ApprovalStatus",
          "default": "not_required"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "decision_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Basis"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CriterionKind",
          "default": "evidence_answerable"
        },
        "kind_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind Source"
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "required"
        },
        "proposal_status": {
          "$ref": "#/$defs/ProposalStatus",
          "default": "supplied"
        },
        "proposed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed By"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "weight_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Rule"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "CriterionKind": {
      "description": "What can settle a criterion: facts about the world, or a judgement of the designs.",
      "enum": [
        "evidence_answerable",
        "design_judgement"
      ],
      "title": "CriterionKind",
      "type": "string"
    },
    "Option": {
      "additionalProperties": false,
      "description": "A candidate answer to a decision question.",
      "properties": {
        "approval_status": {
          "$ref": "#/$defs/ApprovalStatus",
          "default": "not_required"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "named_in_goal": {
          "default": false,
          "title": "Named In Goal",
          "type": "boolean"
        },
        "proposal_status": {
          "$ref": "#/$defs/ProposalStatus",
          "default": "supplied"
        },
        "proposed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed By"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Option",
      "type": "object"
    },
    "Priority": {
      "description": "Required (blocking) versus supporting work.",
      "enum": [
        "required",
        "supporting"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ProposalStatus": {
      "description": "Whether an option was supplied, proposed by a generator, or approved.",
      "enum": [
        "supplied",
        "proposed",
        "approved"
      ],
      "title": "ProposalStatus",
      "type": "string"
    }
  },
  "$id": "leafcutter.decision_request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "leafcutter.decision_request.v1.",
  "properties": {
    "approval_required": {
      "default": false,
      "title": "Approval Required",
      "type": "boolean"
    },
    "constraint_ids": {
      "items": {
        "type": "string"
      },
      "title": "Constraint Ids",
      "type": "array"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/Criterion"
      },
      "title": "Criteria",
      "type": "array"
    },
    "criteria_missing": {
      "default": false,
      "title": "Criteria Missing",
      "type": "boolean"
    },
    "decision_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Scope"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/Option"
      },
      "title": "Options",
      "type": "array"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "question"
  ],
  "title": "DecisionRequestPayload",
  "type": "object"
}
