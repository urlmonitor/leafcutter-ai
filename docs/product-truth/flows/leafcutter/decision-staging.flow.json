  "acceptance_scenarios": [
    {
      "for": "detect",
      "given": "a run that ended with a resolved decision",
      "when": "the decision executor finishes",
      "then": "it hands the decision to the record builder only if a human approved it"
    },
    {
      "for": "build-record",
      "given": "a completed decision approved by a human",
      "when": "the record builder builds the DecisionRecord",
      "then": "the record holds the question, options, criteria, evidence locators and hashes without evidence text, the ranking shown, the precedents considered and the run's provenance, and a non-human approver or a missing approved_at is refused"
    },
    {
      "for": "write-staged",
      "given": "a built DecisionRecord",
      "when": "the file backend saves it",
      "then": "the YAML is written to <run_root>/runs/<run_id>/staged/decisions/<id>.yaml and no file in the repository changes"
    },
    {
      "for": "announce",
      "given": "a staged decision record",
      "when": "the run's result is returned to Claude Code",
      "then": "the message names the staged path, the docs/decisions folder in the kernel checkout that publishing writes into, and a publish command that runs as printed from any shell and directory (the kernel's own interpreter and scripts/run_kernel.py, no PYTHONPATH), and the skill does not publish on its own"
    },
    {
      "for": "not-stageable",
      "given": "a decision resolved by the host alone, or with no human approval",
      "when": "the run ends",
      "then": "no decision record is staged"
    }
  ],
