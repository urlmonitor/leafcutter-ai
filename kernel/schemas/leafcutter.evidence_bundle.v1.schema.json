{
  "$defs": {
    "Contradiction": {
      "additionalProperties": false,
      "description": "Two evidence items that disagree on a point relevant to the question.",
      "properties": {
        "a": {
          "title": "A",
          "type": "string"
        },
        "b": {
          "title": "B",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One excerpt (or artifact reference) with source, hash and verification status.\n\nThe excerpt is the source text verbatim: whitespace is never stripped, so a hash computed over\nthe excerpt as read matches the stored one. `id` and `content_hash` may be omitted on input\n(a host must not invent them): they are then computed from the locator and the body.",
      "properties": {
        "access": {
          "default": "internal",
          "pattern": "^(internal|restricted)$",
          "title": "Access",
          "type": "string"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        },
        "category": {
          "$ref": "#/$defs/EvidenceCategory"
        },
        "content_hash": {
          "minLength": 8,
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_seq": {
          "default": 0,
          "minimum": 0,
          "title": "Created Seq",
          "type": "integer"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "id": {
          "pattern": "^[a-z]+-[0-9a-f]{16}$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_type": {
          "$ref": "#/$defs/SemanticType"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/Verification",
          "default": "unverified"
        }
      },
      "required": [
        "id",
        "category",
        "semantic_type",
        "source",
        "content_hash",
        "provenance"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceCategory": {
      "description": "Generic evidence categories (no vendor names).",
      "enum": [
        "authoritative_guidance",
        "internal_principles",
        "prior_decisions",
        "existing_patterns",
        "task_context",
        "external_practices"
      ],
      "title": "EvidenceCategory",
      "type": "string"
    },
    "EvidenceSource": {
      "additionalProperties": false,
      "description": "Where an Evidence item came from.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "observed_modified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Modified At"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "section_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Locator"
        },
        "source_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "locator"
      ],
      "title": "EvidenceSource",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A source-linked claim: fact, inference, assumption or reported human input.",
      "properties": {
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "contradicting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contradicting Evidence Ids",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_seq": {
          "default": 0,
          "minimum": 0,
          "title": "Created Seq",
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z]+-[0-9a-f]{16}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Version"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "claim",
        "kind",
        "producer"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingKind": {
      "description": "Nature of a Finding.",
      "enum": [
        "source_fact",
        "inference",
        "assumption",
        "human_input"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "NeedStatus": {
      "description": "Completion status of an EvidenceNeed.",
      "enum": [
        "open",
        "satisfied",
        "partial",
        "unavailable"
      ],
      "title": "NeedStatus",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "How an Evidence item was produced.",
      "properties": {
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "invocation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invocation Id"
        },
        "producer": {
          "title": "Producer",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "relayed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relayed By"
        },
        "relevance": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy"
        },
        "terms": {
          "items": {
            "type": "string"
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "producer"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SemanticType": {
      "description": "Semantic type of an Evidence item.",
      "enum": [
        "repository_fact",
        "documentation_fact",
        "human_input",
        "synthesized_finding",
        "task_context"
      ],
      "title": "SemanticType",
      "type": "string"
    },
    "SourceKind": {
      "description": "Kind of evidence source.",
      "enum": [
        "repository_file",
        "knowledge_node",
        "host_research",
        "human",
        "task_input"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceVersion": {
      "additionalProperties": false,
      "description": "Revision identity of a source (commit plus dirty flag).",
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "dirty": {
          "default": false,
          "title": "Dirty",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "SourceVersion",
      "type": "object"
    },
    "UnavailableSource": {
      "additionalProperties": false,
      "description": "A source that could not be consulted, with the reason.",
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "reason"
      ],
      "title": "UnavailableSource",
      "type": "object"
    },
    "Verification": {
      "description": "Verification status of Evidence.",
      "enum": [
        "unverified",
        "host_reported",
        "source_verified"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "$id": "leafcutter.evidence_bundle.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "leafcutter.evidence_bundle.v1: the bundle plus its inline evidence and findings.",
  "properties": {
    "attempted_sources": {
      "items": {
        "type": "string"
      },
      "title": "Attempted Sources",
      "type": "array"
    },
    "contradictions": {
      "items": {
        "$ref": "#/$defs/Contradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "coverage": {
      "additionalProperties": {
        "$ref": "#/$defs/NeedStatus"
      },
      "title": "Coverage",
      "type": "object"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "finding_ids": {
      "items": {
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    },
    "unavailable_sources": {
      "items": {
        "$ref": "#/$defs/UnavailableSource"
      },
      "title": "Unavailable Sources",
      "type": "array"
    }
  },
  "title": "EvidenceBundlePayload",
  "type": "object"
}
