{
  "$defs": {
    "SubjectKind": {
      "description": "What a split's subject is.",
      "enum": [
        "goal",
        "research_request",
        "decision_question"
      ],
      "title": "SubjectKind",
      "type": "string"
    }
  },
  "$id": "leafcutter.goal_decomposition_request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "leafcutter.goal_decomposition_request.v1: what the host is asked to split (ADR-067 4.1).",
  "properties": {
    "allowed_capabilities": {
      "items": {
        "enum": [
          "decision",
          "research"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Capabilities",
      "type": "array"
    },
    "max_parts": {
      "maximum": 5,
      "minimum": 2,
      "title": "Max Parts",
      "type": "integer"
    },
    "min_parts": {
      "default": 2,
      "maximum": 2,
      "minimum": 2,
      "title": "Min Parts",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split_id": {
      "pattern": "^dcp-[0-9a-f]{16}$",
      "title": "Split Id",
      "type": "string"
    },
    "subject_kind": {
      "$ref": "#/$defs/SubjectKind"
    },
    "subject_text": {
      "minLength": 1,
      "title": "Subject Text",
      "type": "string"
    }
  },
  "required": [
    "split_id",
    "subject_kind",
    "subject_text",
    "max_parts"
  ],
  "title": "GoalDecompositionRequestPayload",
  "type": "object"
}
