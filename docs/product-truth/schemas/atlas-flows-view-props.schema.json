  "$defs": {
    "ContractDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authority": {
          "enum": [
            "runtime",
            "source_reviewed",
            "illustrative_design"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [],
      "anyOf": [
        {
          "required": [
            "model"
          ]
        },
        {
          "required": [
            "schema"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "authority"
            ],
            "properties": {
              "authority": {
                "enum": [
                  "source_reviewed",
                  "illustrative_design"
                ]
              }
            }
          },
          "then": {
            "required": [
              "note"
            ]
          }
        }
      ]
    },
