# Development example only. Supply actual values through your secret store.
LEAFCUTTER_NEO4J_URI=neo4j://localhost:17687
LEAFCUTTER_NEO4J_DATABASE=neo4j
LEAFCUTTER_NEO4J_USERNAME=serving_user
LEAFCUTTER_NEO4J_PASSWORD=placeholder
LEAFCUTTER_NEO4J_WRITER_USERNAME=neo4j
LEAFCUTTER_NEO4J_WRITER_PASSWORD=placeholder
# Optional gateway protocol POST {model,texts} -> {model,vectors}.
LEAFCUTTER_EMBEDDING_ENDPOINT=https://embedding-gateway.example.invalid/embed
LEAFCUTTER_EMBEDDING_TOKEN=placeholder
# Model and dimensions are explicit knowledge settings or CLI flags, not these env vars.
# Configure embeddings_enabled=true, embedding_model and embedding_dimensions together.

# Aura serving alternative (use the existing untracked .env; never commit real secrets):
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=placeholder
# NEO4J_INSTANCE is instance metadata only, not the database.
# LEAFCUTTER_ENV_FILE may point to an existing .env outside the worktree.
# NEO4J_DATABASE=your-aura-database
# Explicit config database overrides these aliases; NEO4J_INSTANCE never selects it.
