{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "leafcutter.query_activation_request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Candidate bound to the trusted repository and immutable source.",
  "properties": {
    "candidate": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Candidate",
      "type": "object"
    },
    "component_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Component Ids",
      "type": "array"
    },
    "expected_active_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Active Digest"
    },
    "repository_id": {
      "minLength": 1,
      "title": "Repository Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Source Sha",
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "repository_id",
    "source_sha"
  ],
  "title": "QueryActivationRequest",
  "type": "object"
}
