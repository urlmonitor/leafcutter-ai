  "acceptance_scenarios": [
    {
      "for": "classify",
      "given": "a plain-language feature request",
      "when": "the classifier runs",
      "then": "it returns which of flow / mock data / mockups the request needs, plus the component and entities"
    },
    {
      "for": "search",
      "given": "a classified request naming a component and entities",
      "when": "the pipeline searches the product-truth index",
      "then": "it decides to extend the existing canonical artifact or create a new one, never duplicating a dataset"
    },
    {
      "for": "mockData",
      "given": "a request that needs data",
      "when": "the mock-data agent runs",
      "then": "the one canonical dataset for those entities is drafted or extended in place"
    },
    {
      "for": "mockups",
      "given": "drafted mock data and a request with screens",
      "when": "the mockup agent runs",
      "then": "each screen is produced and populated from that mock data with a resolvable screen id"
    },
    {
      "for": "flow",
      "given": "drafted mock data and mockups",
      "when": "the flow agent runs",
      "then": "a draft flow is assembled with each step wired to its screen, its read/write entities, and an acceptance_scenario"
    },
    {
      "for": "deriveAcs",
      "given": "an approved draft flow",
      "when": "the business-analyst runs",
      "then": "acceptance criteria are derived from the flow's steps and each step is back-linked via step.implements"
    },
    {
      "for": "noFlow",
      "given": "a request classified mockup+data",
      "when": "the pipeline dispatches agents",
      "then": "the mock-data and mockup agents run but the flow agent is skipped"
    },
    {
      "for": "dataOnly",
      "given": "a request classified mock-data-only",
      "when": "the pipeline dispatches agents",
      "then": "only the mock-data agent runs"
    },
    {
      "for": "mockupOnly",
      "given": "a request classified mockup-only",
      "when": "the pipeline dispatches agents",
      "then": "only the mockup agent runs"
    },
    {
      "for": "none",
      "given": "a request classified none",
      "when": "the pipeline dispatches agents",
      "then": "no product-truth artifacts are drafted and the request goes straight to normal AC authoring"
    },
    {
      "for": "flow",
      "given": "the structured JSON contract metadata and the applicable source contracts",
      "when": "Flow agent assembles the journey",
      "then": "The flow author also records each real handoff using source-bound fields and coherent JSON examples, distinguishes runtime contracts from reviewed documentation or illustrative designs, and states any genuinely undefined proposed binding. Internal human/UI transitions state why there is no JSON handoff. The author then regenerates compatibility text and validates the artifact."
    }
