{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source-reviewed product truth index projection",
  "description": "Documentation projection of generate_product_truth.py write_index/build_by_ac/build_by_flow and index.json. Covers lookup fields used by these flows; does not claim a complete index runtime validator or automatic source parity.",
  "type": "object",
  "properties": {
    "by_component": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "flows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mock_data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mockups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "flows",
          "mock_data",
          "mockups"
        ]
      }
    },
    "by_entity": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "canonical_mock_data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "flows": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "by_ac": {
      "type": "object",
      "additionalProperties": {
        "description": "TOOL-OWNED derived back-reference into the product-truth store (docs/product-truth/). GENERATED by docs/product-truth/scripts/generate_product_truth.py as the inversion of every flow step/branch whose `implements` list contains this AC id \u2014 NEVER hand-edited. The authored link direction is flow->AC (step.implements); this list is the recomputed reverse edge so an AC is self-describing (which flow nodes / screens / mock data realise it). The relationship is many-to-many, so this is a LIST. The key is omitted entirely when no flow node references this AC. Regenerate (do not edit) if it drifts; the product-truth validator errors on any mismatch against the by_ac inversion.",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flow",
            "node",
            "node_kind",
            "flow_kind",
            "screen",
            "mock_data",
            "entities",
            "source",
            "asof"
          ],
          "properties": {
            "flow": {
              "type": "string",
              "description": "id of the flow artifact (<product>/<name>) whose node references this AC."
            },
            "node": {
              "type": "string",
              "description": "id of the step or branch within the flow that carries this AC in its `implements` list."
            },
            "node_kind": {
              "type": "string",
              "enum": [
                "step",
                "branch"
              ],
              "description": "Whether the referencing node is a flow step or a branch."
            },
            "flow_kind": {
              "type": "string",
              "description": "The referencing flow's kind (user | data | architecture)."
            },
            "screen": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Bare mockup screen id this node renders, or null when the node has no screen."
            },
            "mock_data": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "id of the flow's mock_data_ref dataset, or null when the flow has none."
            },
            "entities": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Sorted, de-duplicated entity names the node reads/writes."
            },
            "source": {
              "type": "string",
              "description": "The referencing flow's source (mock | real)."
            },
            "asof": {
              "type": "string",
              "description": "Date (YYYY-MM-DD) this back-reference was last regenerated."
            }
          }
        }
      }
    },
    "by_flow": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "flow": {
                  "type": "string"
                },
                "step": {
                  "type": "string"
                }
              },
              "required": [
                "flow",
                "step"
              ]
            }
          },
          "impl_status": {
            "type": "string",
            "enum": [
              "done",
              "in_progress",
              "not_started"
            ]
          }
        }
      }
    },
    "entity_registry": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "type",
          "path"
        ]
      }
    }
  }
}
