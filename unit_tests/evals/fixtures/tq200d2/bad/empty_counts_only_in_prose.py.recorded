import sys
import unittest
from pathlib import Path

sys.path.insert(0, "scripts")
from db_check.checker import resolve_test_db_address

import psycopg2


class TestBuyVolumeWindow(unittest.TestCase):
    def setUp(self):
        self.conn = psycopg2.connect(resolve_test_db_address(Path.cwd()))
        self.conn.autocommit = False

    def tearDown(self):
        self.conn.rollback()
        self.conn.close()

    def test_every_row_has_non_negative_buy_volume(self):
        # covers: TQ-9502
        """The check counts the processed rows with count(*) and the non-NULL values with count(buy_volume)."""
        # count(*) and count(buy_volume) are what a good check would use; this query uses neither.
        with self.conn.cursor() as cur:
            cur.execute("select min(buy_volume) >= 0 from buy_volume_window")
            self.assertTrue(cur.fetchone()[0])
