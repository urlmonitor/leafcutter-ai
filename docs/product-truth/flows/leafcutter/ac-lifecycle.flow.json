  "acceptance_scenarios": [
    {
      "for": "triage",
      "given": "a new plain-language feature request",
      "when": "/plan-feature triages it",
      "then": "it is classified and checked against the store for duplicates before any AC is authored"
    },
    {
      "for": "author",
      "given": "a triaged request",
      "when": "the authoring agents run in sequence",
      "then": "L0-L3 acceptance criteria are written to the AC store and never to ticket files"
    },
    {
      "for": "approve",
      "given": "a completed authoring stage",
      "when": "you approve it",
      "then": "the AC's readiness advances and the stage output is committed to git before the next agent runs"
    },
    {
      "for": "scan",
      "given": "a store of acceptance criteria",
      "when": "the scanner runs",
      "then": "every todo, unblocked leaf AC is surfaced as prioritized ready work"
    },
    {
      "for": "generate",
      "given": "a ready AC",
      "when": "a ticket is generated from it",
      "then": "the ticket is fully wired and the AC records the implemented_by back-reference"
    },
    {
      "for": "complete",
      "given": "an implementing ticket that has merged",
      "when": "the store is updated",
      "then": "the covered ACs' work_status is set to done automatically"
    },
    {
      "for": "govern",
      "given": "an implementation agent editing an AC",
      "when": "it tries to change the criteria text",
      "then": "the change is rejected unless it is the author, and any allowed change is attributed to the agent that made it"
    },
    {
      "for": "backfill",
      "given": "an AC whose implementing code already exists",
      "when": "the discovery audit runs",
      "then": "the implementation is matched and linked via covered_by/implemented_by instead of generating a new ticket"
    },
    {
      "for": "rehome",
      "given": "an AC referenced from many places",
      "when": "it is moved elsewhere in the tree",
      "then": "its permanent id keeps every existing reference working"
    },
    {
      "for": "retire",
      "given": "a retired AC",
      "when": "its retirement is checked",
      "then": "leftover code the AC claimed blocks the commit until it is reconciled"
    }
  ],
