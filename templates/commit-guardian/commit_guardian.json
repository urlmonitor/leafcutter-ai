{
    "_comment": "Commit Guardian — Central Configuration. Edit this file to customize all pre-commit hook behavior.",
    "test_ac_tag_enforcement": "warn",
    "roadmap_staleness_threshold_days": 30,
    "changelogs_dir": "changelogs",
    "excluded_dirs": [
        "unit_tests",
        "alembic",
        "debugging",
        "legacy",
        "tests",
        "templates"
    ],
    "file_size": {
        "_comment": "check_file_size.py — Line limits for NEW files only",
        "line_limits": {
            ".py": 400,
            ".sql": 600
        },
        "default_limit": 400,
        "checked_extensions": [
            ".py",
            ".sql"
        ]
    },
    "complexity": {
        "_comment": "check_complexity.py — Cyclomatic complexity for Python functions",
        "max_score": 15,
        "excluded_dirs": [
            "alembic",
            "legacy"
        ]
    },
    "sql_complexity": {
        "_comment": "check_sql_complexity.py — Keyword-based complexity for SQL files. Threshold raised to 75 to accommodate pre-existing high-complexity procedures that predated this check.",
        "max_score": 75,
        "excluded_dirs": [
            "alembic",
            "legacy"
        ]
    },
    "docstrings": {
        "_comment": "check_docstrings.py — Google-style docstring enforcement",
        "style": "google",
        "trivial_max_lines": 5,
        "enforce_type_annotations": true,
        "exempt_dunders": [
            "__str__",
            "__repr__",
            "__len__",
            "__hash__",
            "__eq__",
            "__ne__",
            "__lt__",
            "__le__",
            "__gt__",
            "__ge__",
            "__bool__",
            "__int__",
            "__float__",
            "__del__",
            "__enter__",
            "__exit__",
            "__iter__",
            "__next__",
            "__contains__",
            "__getitem__",
            "__setitem__",
            "__delitem__",
            "__call__",
            "__format__",
            "__add__",
            "__sub__",
            "__mul__",
            "__truediv__",
            "__floordiv__",
            "__mod__",
            "__pow__",
            "__and__",
            "__or__",
            "__xor__",
            "__neg__",
            "__pos__",
            "__abs__",
            "__invert__"
        ]
    },
    "documentation": {
        "_comment": "check_documentation.py — Module header and decision history enforcement",
        "sql_required_fields": [
            "Object Name:",
            "Goal:",
            "Business Context:",
            "Architecture:"
        ],
        "python_required_fields": [
            "MODULE:",
            "GOAL:",
            "BUSINESS CONTEXT:",
            "ARCHITECTURE:"
        ]
    },
    "root_files": {
        "_comment": "check_root_files.py — Whitelist of files allowed in the project root",
        "allowed_files": [
            ".gitignore",
            ".pre-commit-config.yaml",
            "pyproject.toml",
            "poetry.lock",
            "README.md",
            "alembic.ini",
            "pytest.ini",
            ".env.example",
            ".env.template",
            "settings.py",
            "app_launcher.py",
            "app_launcher_jobs.py",
            "app_setup.py",
            "app_start.py",
            "init-db.sh",
            "remote_query.sh",
            ".antigravityignore",
            "docker-compose.yml",
            "docker-compose.dev.yml",
            "database_queries.py",
            ".security-allowlist",
            ".dockerignore",
            ".env",
            ".flake8",
            ".gitattributes",
            "CLAUDE.md.template",
            "__init__.py",
            "setup.sh",
            "bybit-trader.code-workspace",
            "how-to.md",
            "BOOTSTRAP.md",
            "CLAUDE.md"
        ],
        "allowed_extensions": [
            ".json"
        ]
    },
    "folder_density": {
        "_comment": "check_folder_density.py — Max non-markdown files per folder",
        "max_files_per_folder": 15,
        "excluded_dirs": [
            "__pycache__",
            ".git",
            ".venv",
            "node_modules",
            ".pytest_cache",
            ".mypy_cache",
            ".ruff_cache",
            "_legacy"
        ],
        "exempt_extensions": [
            ".md"
        ],
        "exempt_filenames": [
            "__init__.py"
        ]
    },
    "debug_scripts": {
        "_comment": "check_debug_scripts.py — Metadata tag enforcement for debug scripts",
        "valid_categories": [
            "check",
            "fix",
            "deploy",
            "benchmark",
            "export",
            "verify",
            "analyze",
            "backfill",
            "cleanup",
            "misc"
        ],
        "required_tags": [
            "DEBUG SCRIPT",
            "CATEGORY",
            "DESCRIPTION"
        ],
        "context_tags": [
            "TABLES",
            "FUNCTIONS",
            "WORKERS",
            "SYMBOLS"
        ],
        "exempt_names": [
            "README.md",
            "__init__.py",
            "__pycache__"
        ],
        "exempt_dirs": [
            "_legacy"
        ]
    },
    "infra_docs": {
        "_comment": "check_infra_docs.py — Inline comment enforcement on infra files",
        "infra_file_patterns": [
            "^docker-compose.*\\.ya?ml$",
            "^docker/Dockerfile\\.",
            "^init-db\\.sh$",
            "^\\.env\\.example$"
        ],
        "high_impact_keywords": [
            "mem_limit|shm_size|stop_grace_period|restart|deploy|resources|ulimits",
            "max_wal_size|checkpoint_timeout|shared_buffers|max_connections|max_locks",
            "max_worker_processes|max_parallel_workers|timescaledb\\.max_background_workers",
            "ALTER\\s+SYSTEM\\s+SET"
        ]
    },
    "doc_frontmatter": {
        "_comment": "check_doc_frontmatter.py — YAML frontmatter validation for docs/*.md files",
        "required_fields": {
            "docs/architecture/adrs/**": [
                "title",
                "type",
                "status",
                "created",
                "last_updated",
                "components"
            ],
            "docs/architecture/**": [
                "title",
                "type",
                "status",
                "created",
                "last_updated",
                "components",
                "flight_level"
            ],
            "docs/**": [
                "title",
                "type",
                "status",
                "created",
                "last_updated",
                "components"
            ]
        },
        "allowed_types": [
            "tutorial",
            "how-to",
            "reference",
            "explanation",
            "adr",
            "architecture",
            "retro"
        ],
        "allowed_statuses": [
            "active",
            "draft",
            "deprecated",
            "migrating"
        ],
        "flight_level_values": [
            "L1-Context",
            "L2-Container",
            "L3-Component",
            "L4-Code"
        ],
        "diagram_type_values": [
            "context",
            "container",
            "component",
            "sequence",
            "erd",
            "state",
            "dataflow",
            "none"
        ],
        "components_registry": "docs/components.json",
        "docs_dir": "docs"
    },
    "ticket_frontmatter": {
        "_comment": "check_doc_frontmatter.py — YAML frontmatter validation for tickets/**/*.md (excluding tickets/**/README.md).",
        "required_fields": [
            "title",
            "status",
            "components",
            "created",
            "depends_on"
        ],
        "allowed_statuses": [
            "todo",
            "in_progress",
            "blocked",
            "done",
            "deferred"
        ],
        "allowed_types": [
            "epic"
        ],
        "tickets_dir": "tickets",
        "optional_fields": {
            "ac_coverage": {
                "_comment": "AC completion ratio. Format: N/M (e.g. '3/6'). N = validated ACs, M = total ACs.",
                "pattern": "^\\d+/\\d+$"
            }
        }
    },
    "doc_links": {
        "_comment": "check_doc_links.py — Code-to-doc traceability link validation",
        "severity": "warn",
        "check_bidirectional": true,
        "check_mermaid_architecture_link": true
    },
    "adr_coverage": {
        "_comment": "check_adr_coverage.py — Advisory warning when major structural changes land without an ADR",
        "severity": "warn",
        "triggers": [
            "pyproject.toml (new dependency)",
            "alembic/versions/*.py (new migration)",
            "models/*.py (new ORM model)",
            "docker-compose*.yml (new service)",
            "docs/components.json (new core/service component)"
        ],
        "adr_dir": "adr"
    },
    "doc_coverage": {
        "_comment": "check_doc_coverage.py — Advisory warning when code changes land without doc updates",
        "severity": "warn",
        "large_diff_threshold": 50,
        "use_knowledge_graph": true,
        "knowledge_graph_path": "knowledge_graph.json"
    },
    "structural_change": {
        "_comment": "check_structural_change.py — Structural-change detector configuration",
        "required_doc": "docs/components.json",
        "bypass_token": "[NO-ARCH-UPDATE]",
        "large_diff_threshold": 50,
        "signals": [
            {
                "name": "new model",
                "pattern": "^models/[^/]+\\.py$"
            },
            {
                "name": "new live-trader module",
                "pattern": "^live_trader/[^/]+\\.py$"
            },
            {
                "name": "new collector worker",
                "pattern": "^collector/services/[^/]+/__init__\\.py$"
            },
            {
                "name": "new top-level package",
                "pattern": "^[^/]+/__init__\\.py$"
            },
            {
                "name": "new SQL procedure namespace",
                "pattern": "^sql_functions/procedures/[^/]+/[^/]+\\.sql$"
            }
        ]
    },
    "security_scanner": {
        "_comment": "check_secrets.py — Path to the security-scanner skill's scripts directory, relative to the project root. Override if the skill lives at a different location in your project.",
        "scripts_dir": ".claude/skills/security-scanner/scripts"
    },
    "commit_scope": {
        "_comment": "check_commit_scope.py — Warn-only guard that diffs staged files against the active ticket's files_touched frontmatter. Option (c) hybrid: always exits 0. Upgrade path to blocking (option b): change exit code in check_commit_scope.py.",
        "hook_artefact_patterns": [
            "^changelogs/",
            "\\.md$",
            "^tickets/",
            "^\\.pre-commit-config\\.yaml$"
        ],
        "max_warn_lines": 20
    },
    "hooks_manifest": {
        "_comment": "build_precommit_config() uses this to generate/update .pre-commit-config.yaml. Each entry describes one hook. Package-managed entries are identified by the '@package-managed' marker and are replaced on each build. Project-specific entries (no marker) are preserved.",
        "hooks": [
            {
                "id": "check-build-drift",
                "tier": "judgment",
                "name": "Check Build Drift (leafcutter)",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_build_drift.py",
                "language": "system",
                "files": "^leafcutter/templates/",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-secrets",
                "tier": "judgment",
                "name": "Check Secrets",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_secrets.py",
                "language": "system",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-doc-length",
                "tier": "judgment",
                "name": "Check Documentation Length",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_doc_length.py",
                "language": "system",
                "types": [
                    "markdown"
                ],
                "files": "^docs/.*\\.md$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-structural-change",
                "tier": "judgment",
                "name": "Check Structural Change — Architecture Docs Required",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_structural_change.py",
                "language": "system",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-components-integrity",
                "tier": "judgment",
                "name": "Check Components Registry Integrity",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_components_integrity.py",
                "language": "system",
                "files": "^docs/components\\.json$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-adr-coverage",
                "tier": "judgment",
                "name": "Check ADR Coverage",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_adr_coverage.py",
                "language": "system",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-adr-cross-reference",
                "tier": "judgment",
                "name": "Check ADR Cross-References",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_adr_cross_reference.py",
                "language": "system",
                "files": "^docs/.*\\.md$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-infra-docs",
                "tier": "judgment",
                "name": "Check Infrastructure Documentation",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_infra_docs.py",
                "language": "system",
                "files": "(docker-compose.*\\.ya?ml|docker/Dockerfile\\.|init-db\\.sh|\\.env\\.(example|template))",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-agent-diagrams",
                "tier": "judgment",
                "name": "Check Agent Diagrams",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_agent_diagrams.py",
                "language": "system",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-agent-registry",
                "tier": "judgment",
                "name": "Check Agent Registry",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_agent_registry.py",
                "language": "system",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-mermaid-drift",
                "tier": "judgment",
                "name": "Check Mermaid Diagram Drift",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_mermaid_drift.py",
                "language": "system",
                "files": "^docs/architecture/.*\\.md$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "enabled": false,
                "_comment": "Start disabled until existing data_flow diagrams are seeded with hash markers. Enable after running compute_diagram_hash.py on each."
            },
            {
                "id": "check-mermaid-parent-link",
                "tier": "judgment",
                "name": "Check Mermaid Parent-Link Bidirectionality",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_mermaid_parent_link.py",
                "language": "system",
                "files": "^docs/architecture/.*\\.md$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-diagram-naming",
                "tier": "judgment",
                "name": "Check Architecture Diagram Filename Convention",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_diagram_naming.py",
                "language": "system",
                "files": "^docs/architecture/.*\\.md$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "enabled": false,
                "_comment": "Start disabled until the rename sweep ticket migrates legacy diagram filenames to c{level}-{seq:03d}-{slug}.md convention."
            },
            {
                "id": "check-paths-integrity",
                "tier": "judgment",
                "name": "Check Paths JSON Integrity",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_paths_integrity.py",
                "language": "system",
                "files": "^leafcutter/config/paths\\.json$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-architecture-scaffolds",
                "tier": "judgment",
                "name": "Check Architecture Scaffold Integrity",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_architecture_scaffolds.py",
                "language": "system",
                "files": "^leafcutter/templates/docs/architecture/",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-feedback-id",
                "tier": "judgment",
                "name": "Check Feedback ID in Signoff Comments",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_feedback_id.py",
                "language": "system",
                "files": "^tickets/.*\\.md$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false
            },
            {
                "id": "check-output-drift",
                "tier": "judgment",
                "name": "Check Output Drift (leafcutter Direction B)",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_output_drift.py",
                "language": "system",
                "files": "^(\\.claude/agents/|\\.claude/skills/|\\.claude/commands/|\\.claude/hooks/|\\.claude/workflows/|\\.agents/rules/)",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "_comment": "Direction B drift guard: blocks direct edits to built output files. Companion to check-build-drift (Direction A). Fires when any .claude/ or .agents/ output directory files are staged."
            },
            {
                "id": "check-glossary-coverage",
                "tier": "judgment",
                "name": "Check Glossary Coverage (GlossaryAutomation)",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_glossary_coverage.py",
                "language": "system",
                "files": ".*\\.(md|py|sql)$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "fail_open": true,
                "_comment": "GlossaryAutomation incremental hook: scans staged .md/.py/.sql files for novel jargon, dispatches glossary-triage agent, and re-stages modified glossary files. Always exits 0 (fail-open)."
            },
            {
                "id": "check-placeholder-defaults",
                "tier": "judgment",
                "name": "Check Placeholder-Default Pattern (UserSurfaceVerification)",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_placeholder_defaults.py",
                "language": "system",
                "files": "\\.py$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "_comment": "AST-based hook (ADR-035): blocks commits when a staged .py file contains both a placeholder function (docstring/return token) AND a tainted-default rebinding to that function, unless a # default-path-smoke: <module_stem> marker exists in unit_tests/ or a # noqa: default-path-smoke line appears at the module top."
            },
            {
                "id": "check-commit-scope",
                "tier": "judgment",
                "name": "Check Commit Scope (warn-only — staged vs files_touched)",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_commit_scope.py",
                "language": "system",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "_comment": "Option (c) hybrid guard: diffs staged files against the active ticket's files_touched frontmatter. Always exits 0 — non-blocking advisory only. Upgrade to blocking (option b) by editing check_commit_scope.py. EPIC-AgentSystemFrictionReduction/01."
            },
            {
                "id": "check-doc-types-agents",
                "tier": "judgment",
                "name": "Check Doc Types Agent References",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_doc_types_agents.py",
                "language": "system",
                "files": "(config/doc_types\\.json|config/agent_registry\\.json)",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "_comment": "Validates that every writer_agent in doc_types.json resolves to a non-deprecated entry in agent_registry.json."
            },
            {
                "id": "check-roadmap-schema",
                "tier": "judgment",
                "name": "Check Roadmap JSON Schema Compliance",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_roadmap_schema.py",
                "language": "system",
                "files": "^docs/roadmap\\.json$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "_comment": "ADR-034: Validates docs/roadmap.json against portable-dev-workflow/config/roadmap.schema.json on every commit touching that file. Exits non-zero on schema violations. Fail-open on script errors. See docs/architecture/adrs/ADR-034-roadmap-json-format-and-schema-design.md."
            },
            {
                "id": "regenerate-roadmap-mirror",
                "tier": "judgment",
                "name": "Regenerate docs/roadmap.md mirror",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/regenerate_roadmap_mirror.py",
                "language": "system",
                "files": "^docs/roadmap\\.json$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "_comment": "EPIC-RoadmapStewardship/01: When docs/roadmap.json is staged, regenerates docs/roadmap.md with an AUTO-GENERATED banner and git-adds it so both files land in the same commit. No-op when roadmap.json is not staged. KDD-01: pre-commit stage (not post-commit --amend)."
            },
            {
                "id": "check-mermaid-complexity",
                "tier": "judgment",
                "name": "Check Mermaid Diagram Complexity",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_mermaid_complexity.py",
                "language": "system",
                "files": ".*\\.md$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "_comment": "EPIC-MermaidComplexityGuard/01: Counts structural elements (nodes, edges, participants, subgraphs) in mermaid blocks and warns when thresholds are exceeded. Warn-only by default; set mermaid_complexity.strict to true to block commits."
            },
            {
                "id": "check-contract-shrinking",
                "tier": "judgment",
                "name": "Check Contract Shrinking (TDD Guard)",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_contract_shrinking.py",
                "language": "system",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": false,
                "_comment": "EPIC-TDDWorkflowEnforcement/04: Blocks commits when test-weakening changes (test deletion, pytest.skip, pytest.mark.xfail, @unittest.skip, @unittest.expectedFailure) are staged concurrent with production code changes. Exits 0 when only test changes or only production changes are staged. See docs/how-to/writing-a-tdd-ticket.md."
            },
            {
                "id": "check-exception-handling",
                "tier": "judgment",
                "name": "Check Exception Handling (AST I/O Boundary Guard)",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_exception_handling.py",
                "language": "system",
                "files": "\\.py$",
                "stages": [
                    "pre-commit"
                ],
                "pass_filenames": true,
                "_comment": "EPIC-ErrorHandlingEnforcement/01: AST-based hook that flags bare except: (E722), blind except Exception: without reraise/log (BLE001), and calls to requests.get/open/cursor.execute not enclosed in try/except (IO-001). Runs on every staged .py file. Exit 1 on violations, 0 on clean."
            },
            {
                "id": "check-ticket-no-branch-move",
                "tier": "judgment",
                "name": "Check Ticket No Branch Move (move-on-main-only policy)",
                "entry": "python scripts/commit_guardian/run_hook.py scripts/commit_guardian/check_ticket_no_branch_move.py",
                "language": "system",
                "stages": [
                    "pre-commit"
                ],
