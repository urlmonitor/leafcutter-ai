              "ticket_path": "tickets/01_todo/feature.md"
            }
          },
          {
            "contract": "readback",
            "mode": "projection",
            "origin": "illustrative",
            "label": "Output illustrative readback projection; not an execution receipt",
            "value": {
              "readable": true,
              "ticket_path": "tickets/01_todo/feature.md",
              "signoffs": [
                {
                  "agent": "python-coder",
                  "status": "passed"
