  "acceptance_scenarios": [
    {
      "for": "load",
      "given": "readable flow JSON files in the product-truth store",
      "when": "the uncached getFlows loader runs",
      "then": "it walks the flow files, normalizes their fields and resolves AC references without requiring product-truth index.json"
    },
    {
      "for": "resolve",
      "given": "a loaded flow whose steps carry implements links",
      "when": "the pipeline resolves each step",
      "then": "the step's status is derived from the live work_status of its acceptance criteria"
    },
    {
      "for": "render",
      "given": "a resolved flow",
      "when": "the /flows page renders",
      "then": "the graph is drawn with each step badged by its resolved status and the flow badged by the rollup"
    }
