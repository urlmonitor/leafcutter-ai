      "produces": [
        "readback/readable: boolean (required)",
        "readback/ticket_path: string (optional)",
        "readback/signoffs/*/agent: string (optional)",
        "readback/signoffs/*/status: string (optional)",
        "readback/signed_off_agents: array (optional)"
      ]
    }
  ],
  "branches": [],
  "acceptance_scenarios": [
    {
      "for": "implement",
      "given": "a red baseline handed over from test-writer",
      "when": "python-coder implements against it",
      "then": "only files_touched are edited and the red_baseline tests are the target of the change"
    },
    {
      "for": "tests",
      "given": "an implemented change",
      "when": "the suite is run",
      "then": "the coder does not sign off until every red_baseline test is green"
    }
