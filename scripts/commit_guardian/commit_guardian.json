                "pass_filenames": false,
                "enabled": false,
                "_comment": "GE-101a: Verifies changed lines in staged files have adequate test coverage using diff-cover. Disabled by default (diff_coverage.enabled: false). Fails open when diff-cover is not installed or coverage.xml is absent — emits advisory to stderr and exits 0. Set strict: true to block commits below min_coverage_percent threshold."
            },
            {
                "id": "check-workflow-meta",
                "name": "Check Workflow Meta Pure-Literal Contract",
                "entry": "python {{config.output_root}}/scripts/commit_guardian/run_hook.py {{config.output_root}}/scripts/commit_guardian/check_workflow_meta.py",
                "language": "system",
                "files": "^templates/workflows-js/.*\\.js$",
                "stages": [
