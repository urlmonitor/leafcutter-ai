  "acceptance_scenarios": [
    {
      "for": "form",
      "given": "a question asked through Claude Code",
      "when": "the kernel runs it as a decision",
      "then": "the flow recognizes compact entity meanings before intent, retrieves task evidence afterward, and resolves only after a human approves criteria and makes the ranked choice, carrying approved_by: human:<id> and approved_at"
    },
    {
      "for": "stage",
      "given": "a resolved decision a human approved",
      "when": "the run ends",
      "then": "its record is written under <run_root>/runs/<run_id>/staged/decisions/ and nothing is written into the repository"
    },
    {
      "for": "publish",
      "given": "a staged decision record",
      "when": "a human runs the printed publish command (<python> <repo_root>/scripts/run_kernel.py decisions publish --run-id R)",
      "then": "the record is validated, written to docs/decisions/<id>.yaml, the index is regenerated, and the change is reviewed and merged in git"
    },
    {
      "for": "reuse",
      "given": "a published decision record on main",
      "when": "a later decision run looks for precedent",
      "then": "the record is found through docs/decisions/index.json and is used as evidence, or offered for reuse, but never resolves a decision on its own"
    }
  ],
